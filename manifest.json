{
    "manifest_version": 3,
    "name": "LeetSync",
    "version": "1.0.0",
    "description": "Automatically sync accepted LeetCode solutions to GitHub.",
    "action": {
        "default_popup": "popup/popup.html"
    },
    "background": {
        "service_worker": "background/service-worker.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://leetcode.com/problems/*"
            ],
            "js": [
                "content/page-script.js"
            ],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://leetcode.com/problems/*"
            ],
            "js": [
                "content/content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage",
        "identity"
    ],
    "host_permissions": [
        "https://leetcode.com/*",
        "https://api.github.com/*",
        "https://github.com/*",
        "http://localhost:3000/*"
    ]
}